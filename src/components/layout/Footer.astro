---
import { siteConfig } from '../../config';
import { footerToolLinks, footerGuideLinks, footerLegalLinks } from '../../data/nav';
const year = new Date().getFullYear();
---

<footer class="bg-amber-900 text-amber-100 mt-16 no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav aria-label="Navigation de pied de page">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- À propos -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">{siteConfig.name}</h3>
        <p class="text-amber-200 text-sm leading-relaxed">
          {siteConfig.tagline}. Outils gratuits, calculateurs et guides pratiques
          pour les auto-entrepreneurs au Maroc.
        </p>
        <p class="text-amber-300 text-sm mt-3">
          Par {siteConfig.author.name} ({siteConfig.author.credentials})
        </p>
      </div>

      <!-- Outils -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">Outils Gratuits</h3>
        <ul class="space-y-2 text-sm">
          {footerToolLinks.map(link => (
            <li><a href={link.href} class="text-amber-200 hover:text-white">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Guides -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">Guides</h3>
        <ul class="space-y-2 text-sm">
          {footerGuideLinks.map(link => (
            <li><a href={link.href} class="text-amber-200 hover:text-white">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    </nav>

    <div class="border-t border-amber-800 mt-8 pt-6">
      <h3 class="text-lg font-bold text-white mb-3">Sites utiles</h3>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <li><a href="https://salairemaroc.ma" target="_blank" rel="noopener" class="text-amber-200 hover:text-white">Calculateur Salaire Net Maroc</a></li>
        <li><a href="https://cnssmaroc.ma" target="_blank" rel="noopener" class="text-amber-200 hover:text-white">Simulateur CNSS Maroc</a></li>
        <li><a href="https://banquesmaroc.ma" target="_blank" rel="noopener" class="text-amber-200 hover:text-white">Comparateur Banques Maroc</a></li>
        <li><a href="https://emploipublic.ma" target="_blank" rel="noopener" class="text-amber-200 hover:text-white">Concours Fonction Publique Maroc</a></li>
      </ul>
    </div>

    <div class="border-t border-amber-800 mt-6 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-amber-300 text-sm">
        &copy; {year} {siteConfig.name}. Tous droits réservés.
      </p>
      <div class="flex gap-4 text-sm">
        {footerLegalLinks.map(link => (
          <a href={link.href} class="text-amber-300 hover:text-white">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
