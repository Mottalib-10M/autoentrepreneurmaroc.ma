---
import Layout from '../../components/layout/Layout.astro';
import { siteConfig } from '../../config';
import { getBreadcrumbSchema, getFAQSchema, getArticleSchema } from '../../lib/seo';
import { activites } from '../../data/activites';
import type { Activite } from '../../data/activites';
import { AE_CONFIG } from '../../data/ae-config';
import { simulerRevenuAnnuel } from '../../lib/ae-engine';
import {
  computeActivityCalc,
  getActivityContext,
  buildEnrichedFaqs,
  buildSimulatorSteps,
  getRelatedActivities,
  getBudgetLines,
  getGrowthContent,
} from '../../lib/activity-content';
import {
  generateUniqueFAQs,
  generateUniqueTaxTips,
  generateUniqueBudgetBreakdown,
  generateUniqueComparisons,
  generateUniqueEconomicContext,
  generateUniqueProjection,
  generateUniqueDidYouKnow,
} from '../../lib/unique-content-generator';

export function getStaticPaths() {
  return activites.map((activite) => ({
    params: { slug: activite.slug },
    props: { activite },
  }));
}

interface Props {
  activite: Activite;
}

const { activite } = Astro.props;
const calc = computeActivityCalc(activite);
const ctx = getActivityContext(activite, calc);
const faqs = buildEnrichedFaqs(activite, calc);
const simSteps = buildSimulatorSteps(activite);
const related = getRelatedActivities(activite.slug, activites);
const budgetLines = getBudgetLines(activite.slug);
const growthContent = getGrowthContent(activite.slug, activite);
const budgetTotalMin = budgetLines.reduce((s, l) => s + l.min, 0);
const budgetTotalMax = budgetLines.reduce((s, l) => s + l.max, 0);
const netReelMin = Math.round(calc.netMensuelMin - budgetTotalMax);
const netReelMax = Math.round(calc.netMensuelMax - budgetTotalMin);

// Contenu unique g\u00e9n\u00e9r\u00e9 par montant
const uniqueFaqs = generateUniqueFAQs(activite, calc);
const uniqueTaxTips = generateUniqueTaxTips(activite, calc);
const uniqueBudgetBreakdown = generateUniqueBudgetBreakdown(activite, calc);
const uniqueComparisons = generateUniqueComparisons(activite, calc);
const uniqueEconomicCtx = generateUniqueEconomicContext(activite, calc);
const uniqueProjection = generateUniqueProjection(activite, calc);
const uniqueDidYouKnow = generateUniqueDidYouKnow(activite, calc);

const fmt = (n: number): string =>
  new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(n);

const pageTitle = `${activite.nom} Auto-Entrepreneur au Maroc : charges, IR et revenus 2026`;
const pageDescription = `Guide complet ${activite.nom.toLowerCase()} auto-entrepreneur au Maroc 2026 : simulez vos charges (IR ${activite.tauxIR * 100}%, AMO), revenus nets de ${fmt(calc.netMensuelMin)} à ${fmt(calc.netMensuelMax)} DH/mois, tarifs et formalités.`;

const breadcrumbs = [
  { name: 'Accueil', url: siteConfig.url + '/' },
  { name: 'Activités', url: siteConfig.url + '/activite/' },
  { name: activite.nom, url: siteConfig.url + '/activite/' + activite.slug + '/' },
];

const allFaqsForSchema = [...faqs, ...uniqueFaqs];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    getBreadcrumbSchema(breadcrumbs),
    getFAQSchema(allFaqsForSchema),
    getArticleSchema({
      title: pageTitle,
      description: pageDescription,
      url: siteConfig.url + '/activite/' + activite.slug + '/',
    }),
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  type="article"
  schema={schema}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <nav class="mb-6 text-sm" aria-label="Fil d'Ariane">
      <ol class="flex items-center gap-2 text-gray-500">
        {breadcrumbs.map((crumb, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span class="text-amber-400">/</span>}
            {i === breadcrumbs.length - 1 ? (
              <span class="text-amber-700 font-medium">{crumb.name}</span>
            ) : (
              <a href={crumb.url} class="hover:text-amber-700">{crumb.name}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-amber-900 mb-4">
      {activite.nom} Auto-Entrepreneur au Maroc : Guide Complet 2026
    </h1>

    <p class="text-sm text-gray-500 mb-8">
      Par <a href="/a-propos/" class="text-amber-700 font-medium">{siteConfig.author.name}</a> ({siteConfig.author.credentials})
      &middot; Mis &agrave; jour en 2026
    </p>

    <div class="prose max-w-none">
      <!-- Introduction experte avec E-E-A-T -->
      <p class="text-lg text-gray-700 leading-relaxed">
        {activite.description} D&eacute;couvrez les charges, les revenus attendus, les tarifs du march&eacute; et toutes les d&eacute;marches
        pour exercer comme {activite.nom.toLowerCase()} avec le statut auto-entrepreneur au Maroc en 2026.
      </p>

      <p class="text-gray-700 leading-relaxed">
        {ctx.introExpert}
      </p>

      <!-- Mini-simulateur : stat cards -->
      <div class="not-prose my-8">
        <h2 class="text-xl font-bold text-amber-900 mb-4">&#9998; Simulateur rapide : {activite.nom} AE</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
            <p class="text-sm text-gray-500">IR annuel</p>
            <p class="text-xl font-bold text-amber-800">{fmt(calc.irAnnuelMin)} DH</p>
            <p class="text-xs text-gray-400">pour {fmt(calc.caMensuelMin)} DH/mois</p>
          </div>
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
            <p class="text-sm text-gray-500">AMO / CNSS</p>
            <p class="text-xl font-bold text-amber-800">{fmt(calc.amoAnnuel)} DH/an</p>
            <p class="text-xs text-gray-400">{fmt(calc.amoTrimestriel)} DH/trimestre</p>
          </div>
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
            <p class="text-sm text-gray-500">Total charges</p>
            <p class="text-xl font-bold text-amber-800">{fmt(calc.totalChargesAnnuelMin)} DH/an</p>
            <p class="text-xs text-gray-400">taux effectif {calc.tauxEffectifMin}%</p>
          </div>
          <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
            <p class="text-sm text-gray-500">Revenu net</p>
            <p class="text-xl font-bold text-green-700">{fmt(calc.netMensuelMin)} DH/mois</p>
            <p class="text-xs text-gray-400">apr&egrave;s IR + AMO</p>
          </div>
        </div>
        <p class="text-sm text-gray-500 text-center">
          * Calcul bas&eacute; sur un CA mensuel de {fmt(calc.caMensuelMin)} DH.
          <a href="/calculateur-charges-ae/" class="text-amber-700 underline">Simulez avec votre CA r&eacute;el &rarr;</a>
        </p>
      </div>

      <!-- Tableau récapitulatif -->
      <div class="not-prose my-8 bg-amber-50 border border-amber-200 rounded-xl p-6">
        <h2 class="text-xl font-bold text-amber-900 mb-4">Fiche r&eacute;capitulative : {activite.nom} AE</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white rounded-lg p-4 border border-amber-100">
            <p class="text-sm text-gray-500">Type d&rsquo;activit&eacute;</p>
            <p class="text-lg font-bold text-amber-800">
              {activite.type === 'services' ? 'Prestation de services' : 'Commerciale / Artisanale'}
            </p>
          </div>
          <div class="bg-white rounded-lg p-4 border border-amber-100">
            <p class="text-sm text-gray-500">Taux IR forfaitaire</p>
            <p class="text-lg font-bold text-amber-800">{activite.tauxIR * 100}% du CA</p>
          </div>
          <div class="bg-white rounded-lg p-4 border border-amber-100">
            <p class="text-sm text-gray-500">Plafond CA annuel</p>
            <p class="text-lg font-bold text-amber-800">{fmt(activite.plafondCA)} DH</p>
          </div>
          <div class="bg-white rounded-lg p-4 border border-amber-100">
            <p class="text-sm text-gray-500">Revenu mensuel moyen</p>
            <p class="text-lg font-bold text-amber-800">{fmt(activite.revenuMoyen.min)} - {fmt(activite.revenuMoyen.max)} DH</p>
          </div>
          <div class="bg-white rounded-lg p-4 border border-amber-100">
            <p class="text-sm text-gray-500">Tarifs du march&eacute;</p>
            <p class="text-lg font-bold text-amber-800">{activite.tarifMoyen}</p>
          </div>
          <div class="bg-white rounded-lg p-4 border border-amber-100">
            <p class="text-sm text-gray-500">Taux effectif de charges</p>
            <p class="text-lg font-bold text-amber-800">{calc.tauxEffectifMin}% - {calc.tauxEffectifMax}% du CA</p>
          </div>
          <div class="bg-white rounded-lg p-4 border border-amber-100">
            <p class="text-sm text-gray-500">Revenu net mensuel</p>
            <p class="text-lg font-bold text-green-700">{fmt(calc.netMensuelMin)} - {fmt(calc.netMensuelMax)} DH</p>
          </div>
          <div class="bg-white rounded-lg p-4 border border-amber-100">
            <p class="text-sm text-gray-500">Utilisation du plafond</p>
            <p class="text-lg font-bold text-amber-800">{calc.pourcentagePlafondMin}% - {calc.pourcentagePlafondMax}%</p>
          </div>
        </div>
      </div>

      <!-- Fiscalité détaillée avec valeurs calculées -->
      <h2>Fiscalit&eacute; d&eacute;taill&eacute;e : {activite.nom} auto-entrepreneur 2026</h2>

      <p>
        En tant que {activite.nom.toLowerCase()} auto-entrepreneur au Maroc, vos charges obligatoires se composent de deux &eacute;l&eacute;ments
        principaux : l&rsquo;imp&ocirc;t sur le revenu (IR) forfaitaire &agrave; {activite.tauxIR * 100}% du chiffre d&rsquo;affaires et la cotisation
        AMO (Assurance Maladie Obligatoire) de {fmt(calc.amoAnnuel)} DH par an. Le r&eacute;gime forfaitaire de l&rsquo;auto-entrepreneur
        (loi 114-13) est con&ccedil;u pour simplifier la vie des ind&eacute;pendants marocains en rempla&ccedil;ant l&rsquo;ensemble des
        imp&ocirc;ts et taxes par un pr&eacute;l&egrave;vement unique et proportionnel au chiffre d&rsquo;affaires r&eacute;alis&eacute;.
      </p>

      <p>{ctx.fiscaliteDetail}</p>

      <!-- Tableau des charges détaillé -->
      <div class="not-prose my-6">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-amber-100">
              <th class="border border-amber-200 px-4 py-2 text-left text-amber-900">Charge</th>
              <th class="border border-amber-200 px-4 py-2 text-right text-amber-900">Montant annuel</th>
              <th class="border border-amber-200 px-4 py-2 text-right text-amber-900">Montant trimestriel</th>
              <th class="border border-amber-200 px-4 py-2 text-left text-amber-900">Fr&eacute;quence</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="border border-amber-200 px-4 py-2">IR forfaitaire ({activite.tauxIR * 100}% du CA)</td>
              <td class="border border-amber-200 px-4 py-2 text-right">{fmt(calc.irAnnuelMin)} DH</td>
              <td class="border border-amber-200 px-4 py-2 text-right">{fmt(calc.irTrimestrielMin)} DH</td>
              <td class="border border-amber-200 px-4 py-2">Trimestrielle</td>
            </tr>
            <tr class="bg-amber-50">
              <td class="border border-amber-200 px-4 py-2">Cotisation AMO (CNSS)</td>
              <td class="border border-amber-200 px-4 py-2 text-right">{fmt(calc.amoAnnuel)} DH</td>
              <td class="border border-amber-200 px-4 py-2 text-right">{fmt(calc.amoTrimestriel)} DH</td>
              <td class="border border-amber-200 px-4 py-2">Trimestrielle</td>
            </tr>
            <tr class="font-bold bg-amber-100">
              <td class="border border-amber-200 px-4 py-2">Total charges obligatoires</td>
              <td class="border border-amber-200 px-4 py-2 text-right">{fmt(calc.totalChargesAnnuelMin)} DH</td>
              <td class="border border-amber-200 px-4 py-2 text-right">{fmt(calc.irTrimestrielMin + calc.amoTrimestriel)} DH</td>
              <td class="border border-amber-200 px-4 py-2">-</td>
            </tr>
            <tr class="font-bold text-green-700">
              <td class="border border-amber-200 px-4 py-2">Revenu net annuel</td>
              <td class="border border-amber-200 px-4 py-2 text-right">{fmt(calc.netAnnuelMin)} DH</td>
              <td class="border border-amber-200 px-4 py-2 text-right">{fmt(Math.round(calc.netAnnuelMin / 4))} DH</td>
              <td class="border border-amber-200 px-4 py-2">-</td>
            </tr>
          </tbody>
        </table>
        <p class="text-sm text-gray-500 mt-2">
          * Calcul bas&eacute; sur un CA mensuel de {fmt(calc.caMensuelMin)} DH (fourchette basse du march&eacute;)
        </p>
      </div>

      <p>
        Avec un CA mensuel de {fmt(calc.caMensuelMin)} DH, votre revenu net mensuel (apr&egrave;s IR et AMO)
        est d&rsquo;environ <strong>{fmt(calc.netMensuelMin)} DH</strong>, soit un taux effectif de
        charges de seulement <strong>{calc.tauxEffectifMin}%</strong>. Pour un CA mensuel de {fmt(calc.caMensuelMax)} DH
        (fourchette haute), votre revenu net atteint <strong>{fmt(calc.netMensuelMax)} DH par mois</strong> apr&egrave;s
        des charges totales de {fmt(calc.totalChargesAnnuelMax)} DH/an (taux effectif de {calc.tauxEffectifMax}%).
        Utilisez notre <a href="/calculateur-charges-ae/">calculateur de charges</a> pour simuler avec votre CA r&eacute;el.
      </p>

      <!-- Tableau comparatif par palier de CA -->
      <h2>Tableau comparatif des charges par palier de CA mensuel</h2>

      <p>
        Le tableau ci-dessous pr&eacute;sente les charges mensuelles et le revenu net d&rsquo;un {activite.nom.toLowerCase()} auto-entrepreneur
        pour diff&eacute;rents niveaux de chiffre d&rsquo;affaires. Ces chiffres vous permettent d&rsquo;estimer rapidement votre situation
        financi&egrave;re selon votre volume d&rsquo;activit&eacute; pr&eacute;visionnel.
      </p>

      <div class="not-prose my-6">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-amber-100">
              <th class="border border-amber-200 px-3 py-2 text-right text-amber-900">CA mensuel</th>
              <th class="border border-amber-200 px-3 py-2 text-right text-amber-900">IR/mois</th>
              <th class="border border-amber-200 px-3 py-2 text-right text-amber-900">AMO/mois</th>
              <th class="border border-amber-200 px-3 py-2 text-right text-amber-900">Total charges</th>
              <th class="border border-amber-200 px-3 py-2 text-right text-amber-900">Net mensuel</th>
              <th class="border border-amber-200 px-3 py-2 text-right text-amber-900">Taux effectif</th>
            </tr>
          </thead>
          <tbody>
            {simSteps.map((step, i) => (
              <tr class={i % 2 === 0 ? '' : 'bg-amber-50'}>
                <td class="border border-amber-200 px-3 py-2 text-right font-medium">{fmt(step.ca)} DH</td>
                <td class="border border-amber-200 px-3 py-2 text-right">{fmt(step.ir)} DH</td>
                <td class="border border-amber-200 px-3 py-2 text-right">{fmt(step.amo)} DH</td>
                <td class="border border-amber-200 px-3 py-2 text-right">{fmt(step.total)} DH</td>
                <td class="border border-amber-200 px-3 py-2 text-right font-bold text-green-700">{fmt(step.net)} DH</td>
                <td class="border border-amber-200 px-3 py-2 text-right">{step.tauxEffectif}%</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="text-sm text-gray-500 mt-2">
          * IR &agrave; {activite.tauxIR * 100}% (activit&eacute; {activite.type === 'services' ? 'de services' : 'commerciale'}) + AMO {fmt(calc.amoAnnuel)} DH/an. Plafond CA annuel : {fmt(calc.plafondCA)} DH.
        </p>
      </div>

      <!-- Revenus et tarifs du marché -->
      <h2>Revenus et tarifs du march&eacute; : {activite.nom.toLowerCase()} au Maroc</h2>

      <p>
        Le chiffre d&rsquo;affaires d&rsquo;un {activite.nom.toLowerCase()} auto-entrepreneur au Maroc varie entre
        <strong>{fmt(activite.revenuMoyen.min)} DH</strong> et
        <strong>{fmt(activite.revenuMoyen.max)} DH par mois</strong>, soit un CA annuel de
        <strong>{fmt(calc.caAnnuelMin)} DH</strong> &agrave; <strong>{fmt(calc.caAnnuelMax)} DH</strong>.
        Les tarifs du march&eacute; se situent autour de <strong>{activite.tarifMoyen}</strong>.
        Ces chiffres d&eacute;pendent de votre exp&eacute;rience, de votre sp&eacute;cialisation et de votre localisation g&eacute;ographique
        (Casablanca, Rabat, Marrakech et Tanger offrent g&eacute;n&eacute;ralement les tarifs les plus &eacute;lev&eacute;s).
      </p>

      <p>
        En termes de revenus nets, un {activite.nom.toLowerCase()} AE conserve entre <strong>{fmt(calc.netMensuelMin)} DH</strong>
        et <strong>{fmt(calc.netMensuelMax)} DH par mois</strong> apr&egrave;s d&eacute;duction de l&rsquo;IR forfaitaire et de l&rsquo;AMO.
        Ce taux de r&eacute;tention de {(100 - parseFloat(calc.tauxEffectifMin)).toFixed(1)}% &agrave; {(100 - parseFloat(calc.tauxEffectifMax)).toFixed(1)}% est
        nettement sup&eacute;rieur &agrave; celui d&rsquo;un salari&eacute; au r&eacute;gime r&eacute;el, o&ugrave; les pr&eacute;l&egrave;vements
        peuvent atteindre 30 &agrave; 45% du revenu brut.
      </p>

      {activite.autorisations.length > 0 && (
        <>
          <h2>Autorisations et formalit&eacute;s sp&eacute;cifiques</h2>
          <p>
            L&rsquo;exercice de l&rsquo;activit&eacute; de {activite.nom.toLowerCase()} en auto-entrepreneur au Maroc peut n&eacute;cessiter
            certaines autorisations ou formalit&eacute;s sp&eacute;cifiques :
          </p>
          <ul>
            {activite.autorisations.map((auth) => (
              <li><strong>{auth}</strong></li>
            ))}
          </ul>
          <p>
            Renseignez-vous aupr&egrave;s de votre commune et des organismes comp&eacute;tents pour conna&icirc;tre les exigences
            exactes dans votre ville et pour votre sp&eacute;cialit&eacute;. Le d&eacute;faut d&rsquo;autorisation peut entra&icirc;ner
            des sanctions administratives et financi&egrave;res.
          </p>
        </>
      )}

      <!-- Contenu éditorial original -->
      <h2>Devenir {activite.nom.toLowerCase()} auto-entrepreneur au Maroc en 2026</h2>

      {activite.editorial.split('\n\n').map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <!-- Obligations légales -->
      <h2>Obligations l&eacute;gales et r&eacute;glementaires</h2>

      <p>{ctx.obligationsLegales}</p>

      <p>
        Tout auto-entrepreneur au Maroc doit respecter les obligations suivantes, quel que soit son domaine d&rsquo;activit&eacute; :
        d&eacute;claration trimestrielle du chiffre d&rsquo;affaires sur la plateforme ae.gov.ma (m&ecirc;me en cas de CA nul),
        paiement de l&rsquo;IR forfaitaire et de l&rsquo;AMO dans les d&eacute;lais impartis, tenue d&rsquo;un registre chronologique
        des recettes, et &eacute;mission de factures conformes comportant toutes les mentions l&eacute;gales obligatoires
        (ICE, mention d&rsquo;exon&eacute;ration TVA, coordonn&eacute;es compl&egrave;tes). Le non-respect de la d&eacute;claration
        trimestrielle entra&icirc;ne une p&eacute;nalit&eacute; de 15% du montant d&ucirc;, major&eacute;e de 0,5% par mois de retard.
      </p>

      <!-- Conseils pratiques -->
      <h2>Conseils pratiques pour r&eacute;ussir comme {activite.nom.toLowerCase()} AE</h2>

      <p>{ctx.conseilsPratiques}</p>

      <p>
        La gestion financi&egrave;re est cl&eacute; pour tout auto-entrepreneur. Avec des charges obligatoires de seulement
        {fmt(calc.totalChargesMensuelMin)} DH par mois (pour un CA de {fmt(calc.caMensuelMin)} DH), l&rsquo;essentiel de votre
        gestion portera sur vos charges d&rsquo;exploitation, votre prospection commerciale et la fid&eacute;lisation de votre client&egrave;le.
        Ouvrez un compte bancaire d&eacute;di&eacute; &agrave; votre activit&eacute; pour s&eacute;parer vos finances personnelles et professionnelles,
        m&ecirc;me si ce n&rsquo;est pas l&eacute;galement obligatoire pour les auto-entrepreneurs.
      </p>

      <!-- Comparaison AE vs SARL vs SAS -->
      <h2>Comparaison des statuts : AE vs SARL pour un {activite.nom.toLowerCase()}</h2>

      <p>{ctx.comparaisonStatuts}</p>

      <div class="not-prose my-6">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-amber-100">
              <th class="border border-amber-200 px-4 py-2 text-left text-amber-900">Crit&egrave;re</th>
              <th class="border border-amber-200 px-4 py-2 text-center text-amber-900">Auto-Entrepreneur</th>
              <th class="border border-amber-200 px-4 py-2 text-center text-amber-900">SARL</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="border border-amber-200 px-4 py-2 font-medium">Imp&ocirc;t</td>
              <td class="border border-amber-200 px-4 py-2 text-center">IR {activite.tauxIR * 100}% du CA<br/>({fmt(calc.irAnnuelMin)} DH/an)</td>
              <td class="border border-amber-200 px-4 py-2 text-center">IS 10-31% du b&eacute;n&eacute;fice</td>
            </tr>
            <tr class="bg-amber-50">
              <td class="border border-amber-200 px-4 py-2 font-medium">Charges sociales</td>
              <td class="border border-amber-200 px-4 py-2 text-center">AMO : {fmt(calc.amoAnnuel)} DH/an</td>
              <td class="border border-amber-200 px-4 py-2 text-center">CNSS : ~33% du salaire g&eacute;rant</td>
            </tr>
            <tr>
              <td class="border border-amber-200 px-4 py-2 font-medium">Plafond CA</td>
              <td class="border border-amber-200 px-4 py-2 text-center">{fmt(calc.plafondCA)} DH/an</td>
              <td class="border border-amber-200 px-4 py-2 text-center">Illimit&eacute;</td>
            </tr>
            <tr class="bg-amber-50">
              <td class="border border-amber-200 px-4 py-2 font-medium">TVA</td>
              <td class="border border-amber-200 px-4 py-2 text-center">Exon&eacute;r&eacute;</td>
              <td class="border border-amber-200 px-4 py-2 text-center">20% (r&eacute;cup&eacute;rable)</td>
            </tr>
            <tr>
              <td class="border border-amber-200 px-4 py-2 font-medium">D&eacute;duction charges</td>
